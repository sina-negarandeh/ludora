# Copy to backend/.env and fill in real values. Everything else in this
# app (DB, LLM server) works fine with zero .env file at all -- this is
# the first genuinely optional/secret setting, needed only for Langfuse
# LLM tracing (see langfuse/README.md).

# From the root .env's LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY --
# the self-hosted Langfuse stack (`make langfuse-up`) auto-provisions
# these on first boot, no manual UI step needed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
