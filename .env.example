# Copy to .env and fill in real values (or run the generator commands below).
# Only needed for the self-hosted Langfuse stack (docker-compose.yml's
# `langfuse` profile, see langfuse/README.md) -- the base stack and the LGTM
# observability stack use no env-var secrets at all.

# openssl rand -hex 16
LANGFUSE_SALT=
# openssl rand -hex 32 -- must be exactly 64 hex chars (32 bytes)
LANGFUSE_ENCRYPTION_KEY=
# openssl rand -hex 16
LANGFUSE_NEXTAUTH_SECRET=
# openssl rand -hex 16 -- Langfuse's own Postgres, unrelated to ludora_db
LANGFUSE_POSTGRES_PASSWORD=
# openssl rand -hex 16
LANGFUSE_REDIS_AUTH=
# openssl rand -hex 16
LANGFUSE_CLICKHOUSE_PASSWORD=
# openssl rand -hex 16
LANGFUSE_MINIO_ROOT_PASSWORD=

# Auto-provisions an org/project/user/API-keypair on first boot -- no manual
# sign-up/create-project click-through. IDs can be any UUID
# (python3 -c "import uuid; print(uuid.uuid4())"); keys any pk-lf-.../sk-lf-...
# string (python3 -c "import uuid; print('pk-lf-' + str(uuid.uuid4()))").
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=Ludora
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=ludora-assistant
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@ludora.dev
LANGFUSE_INIT_USER_NAME=Ludora Admin
# openssl rand -hex 12
LANGFUSE_INIT_USER_PASSWORD=

# Copy LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY into backend/.env as
# LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY -- see backend/.env.example.
